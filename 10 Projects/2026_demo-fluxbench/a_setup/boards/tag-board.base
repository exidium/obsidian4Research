# Generated by _system/scripts/tag_board.py — one Kanban per tag group, lanes = that group's tags.
# Reads highlight notes live. Re-run the script when a tag group is added to tags.yaml.
filters:
  and:
    - note.type == "highlight"
    - note.project == "2026_demo-fluxbench"
formulas:
  experience: 'note.tags.filter(value.startsWith("experience/")).join(", ")'
  functionality: 'note.tags.filter(value.startsWith("functionality/")).join(", ")'
  insight: 'note.tags.filter(value.startsWith("insight/")).join(", ")'
  sentiment: 'note.tags.filter(value.startsWith("sentiment/")).join(", ")'
  ops: 'note.tags.filter(value.startsWith("ops/")).join(", ")'
  journey: 'note.tags.filter(value.startsWith("journey/")).join(", ")'
  software: 'note.tags.filter(value.startsWith("software/")).join(", ")'
  market: 'note.tags.filter(value.startsWith("market/")).join(", ")'
  workflow: 'note.tags.filter(value.startsWith("workflow/")).join(", ")'
  tools: 'note.tags.filter(value.startsWith("tools/")).join(", ")'
  correlation: 'note.tags.filter(value.startsWith("correlation/")).join(", ")'
  sharing: 'note.tags.filter(value.startsWith("sharing/")).join(", ")'
  licensing: 'note.tags.filter(value.startsWith("licensing/")).join(", ")'
  docs: 'note.tags.filter(value.startsWith("docs/")).join(", ")'
  export: 'note.tags.filter(value.startsWith("export/")).join(", ")'
  selection: 'note.tags.filter(value.startsWith("selection/")).join(", ")'
  competition: 'note.tags.filter(value.startsWith("competition/")).join(", ")'
views:
  - type: kanban
    name: "Experience level"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.experience
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "Functionality"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.functionality
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "Insight"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.insight
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "Sentiment"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.sentiment
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "Research ops"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.ops
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "Journey stage"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.journey
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "Software"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.software
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "Market"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.market
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "1. Workflow and Process"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.workflow
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "2. Tool Behaviour"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.tools
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "3. Simulation vs Bench"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.correlation
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "4. Sharing and Versions"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.sharing
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "5. Licensing and Offline"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.licensing
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "6. Documentation and Support"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.docs
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "7. Export and Handoff"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.export
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "8. Part Selection"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.selection
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "9. Competition"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: formula.competition
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "By participant"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: note.participant
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: kanban
    name: "By review status"
    filters:
      and:
        - note.review != "rejected"
    groupBy:
      property: note.review
      direction: ASC
    order:
      - file.name
      - note.quote
      - note.participant
      - note.review
      - note.tags
  - type: table
    name: All highlights
    order:
      - file.name
      - note.participant
      - note.tags
      - note.review
      - note.quote
    sort:
      - property: file.name
        direction: ASC
