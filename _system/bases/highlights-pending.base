filters:
  and:
    - note.type == "highlight"
    - note.review == "proposed"
    - file.folder.startsWith(this.file.folder)
views:
  - type: table
    name: Pending review
    order:
      - file.name
      - note.review
      - note.participant
      - note.tags
      - note.quote
    sort:
      - property: file.name
        direction: ASC
