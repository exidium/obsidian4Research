filters:
  and:
    - note.type == "insight"
    - file.folder.startsWith(this.file.folder)
views:
  - type: table
    name: Insights
    order:
      - file.name
      - note.evidence_level
      - note.status
      - note.participants
      - note.research_question
      - note.tags
    sort:
      - property: note.evidence_level
        direction: DESC
      - property: file.name
        direction: ASC
