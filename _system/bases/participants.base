filters:
  and:
    - note.type == "participant"
views:
  - type: table
    name: Participants
    order:
      - file.name
      - note.participant_type
      - note.role
      - note.experience
      - note.market
      - note.industry
      - note.region
      - note.persona
      - note.consent_status
      - note.projects
    sort:
      - property: file.name
        direction: ASC
  - type: cards
    name: Cards
    order:
      - file.name
      - note.role
      - note.market
      - note.persona
