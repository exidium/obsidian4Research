# Generated by _system/scripts/tag_board.py — Dovetail-style tag board: lanes = tag groups, cards = tags.
# Click a card to open the tag page (definition + live list of its highlights).
filters:
  and:
    - note.type == "tag"
    - note.status != "deprecated"
    - file.folder.startsWith("_system/tags")
views:
  - type: kanban
    name: Tag board
    groupBy:
      property: note.group_name
      direction: ASC
    groupOrder:
      - "Experience level"
      - "Functionality"
      - "Insight"
      - "Sentiment"
      - "Research ops"
      - "Journey stage"
      - "Software"
      - "Market"
    order:
      - file.name
      - note.definition
      - note.highlights
      - note.participants
      - note.status
  - type: table
    name: All tags
    groupBy:
      property: note.group_name
      direction: ASC
    order:
      - note.tag
      - note.definition
      - note.highlights
      - note.participants
      - note.status
      - note.level
    sort:
      - property: note.highlights
        direction: DESC
